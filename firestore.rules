        {'version':4,'factoryCost':2000000,'factoryRevenue':440000,'equipmentCost':1000000,'equipmentRevenue':200000,'researchCost':500000,'researchBoostBps':500,'employeeCost':100000,'employeeRevenue':20000};
    }
    function investmentDay(o) {
