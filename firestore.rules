          o.indexVersion == 1 && o.indexCursor < o.orders.size() && a.entry == o.orders[o.indexCursor] && d.indexCursor == o.indexCursor+1 && d.indexVersion == (d.indexCursor == o.orders.size() ? 2 : 1) &&
