        d.pendingStaffRevenue == o.get('pendingStaffRevenue',0)+(asset == 'employee' ? c.employeeRevenue : 0) &&
        d.activeResearchBps == researchBps(o) && d.pendingResearchBps == o.get('pendingResearchBps',0)+(asset == 'research' ? c.researchBoostBps : 0);
    }
