rules_version = '2';
// users/{uid}: displayName string, role student|president|admin, active bool.
// portfolios/{uid}: cash integer (simulation units), holdings array <= 100,
// version integer. Only trusted staff/server may provision or update these.
// assignments/{uid}: companyIds array <= 5.
// companies/{id}: presentation data only; ticker string, name string, etc.
// news/{id}: presentation data only; title, content, publishedAt timestamp.
// No email, password, key, or private student data in companies/news.
service cloud.firestore {
  match /databases/{database}/documents {
    function competitionRunning() { return !exists(/databases/$(database)/documents/marketFinalization/main); }
    match /marketFinalization/{id} {
      allow get: if id == 'main' && participant();
      allow list,write: if false;
    }
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/systemMaintenance/reset); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function schoolClaims() {
      let claims=request.auth.token;
      return claims.email_verified == true && claims.email is string && claims.email.lower().matches('^[^ @]+@hcu[.]hs[.]kr$');
    }
    function schoolVerified() { return signedIn() && schoolClaims(); }
    // Cache profile/claims within each check: partial fills validate several
    // atomic writes and must remain below the Rules expression budget.
    function participantProfile() {
      let profile=get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.active == true && (profile.role == 'admin' || schoolClaims());
    }
    function participant() { return signedIn() && participantProfile(); }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true; }
    function str(v, n) { return v is string && v.size() > 0 && v.size() <= n; }
    function ids(v) { return v is list && v.size() <= 5 &&
      (v.size() < 1 || v[0] is string) && (v.size() < 2 || v[1] is string) &&
      (v.size() < 3 || v[2] is string) && (v.size() < 4 || v[3] is string) && (v.size() < 5 || v[4] is string); }
    function userData() { let d=request.resource.data; return d.keys().hasOnly(['displayName','role','active','email']) && (!('email' in d) || str(d.email,254) && d.email.matches('^[^ @]+@hcu[.]hs[.]kr$')) && str(d.displayName,80) && d.role in ['student','president'] && d.active is bool; }
    function companyData() { let d=request.resource.data; return d.keys().hasOnly(['name','ticker','description','category','status','referencePrice','issuedShares','companyCash','dailyRevenue']) && str(d.name,80) && str(d.ticker,20) && d.description is string && d.description.size() <= 2000 && str(d.category,40) && d.status in ['draft','listed','paused']; }
    match /users/{uid} {
      // Inactive students can read their own registration status only.
      allow get: if owner(uid) || admin();
      allow list: if admin() && request.query.limit != null && request.query.limit <= 100;
      allow create: if owner(uid) && schoolVerified() && userData() && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email.lower()) && request.resource.data.role == 'student' && request.resource.data.active == true &&
        getAfter(/databases/$(database)/documents/portfolios/$(uid)).data.cash == 1000000 &&
        getAfter(/databases/$(database)/documents/portfolios/$(uid)).data.holdings == [] &&
        getAfter(/databases/$(database)/documents/portfolios/$(uid)).data.version == 0;
      allow update: if (admin() && resource.data.role != 'admin' && userData() && request.resource.data.get('email','') == resource.data.get('email','')) ||
        (owner(uid) && schoolVerified() && resource.data.active == true && userData() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']) && request.resource.data.email == request.auth.token.email.lower());
      allow delete: if false;
    }
    match /portfolios/{uid} {
      allow get: if owner(uid) && participant();
      allow create: if owner(uid) && schoolVerified() && !exists(/databases/$(database)/documents/users/$(uid)) &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'student' &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.active == true &&
        request.resource.data.keys().hasOnly(['cash','holdings','version','initialCapital']) &&
        request.resource.data.initialCapital == 1000000 && request.resource.data.cash is int && request.resource.data.cash == 1000000 &&
        request.resource.data.holdings == [] && request.resource.data.version is int && request.resource.data.version == 0;
      allow list, update, delete: if false;
    }
    match /assignments/{uid} {
      allow get: if (owner(uid) && participant()) || admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['companyIds']) && ids(request.resource.data.companyIds);
      allow list, delete: if false;
    }
    // companyLeadership/main: company ID -> active president display names, no UID/email.
    function leadershipData(d) { return d.keys().hasOnly(['companies','updatedAt']) && d.companies is map && d.companies.size() <= 1000 && d.updatedAt == request.time; }
    match /companyLeadership/{id} {
      allow get: if id == 'main' && participant();
      allow create, update: if id == 'main' && admin() && leadershipData(request.resource.data);
      allow list, delete: if false;
    }
    match /companies/{id} {
      allow get: if participant();
      allow list: if participant() && request.query.limit != null && request.query.limit <= 100;
      allow create: if admin() && companyData() && request.resource.data.referencePrice is int && request.resource.data.referencePrice > 0 && request.resource.data.referencePrice <= 1000000 && request.resource.data.issuedShares is int && request.resource.data.issuedShares > 0 && request.resource.data.issuedShares <= 1000000 && request.resource.data.companyCash == 0 && request.resource.data.dailyRevenue == 0;
      allow update: if admin() && companyData() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','ticker','description','category','status']);
      allow delete: if false;
    }
    function eventNewsData(d) {
      return !('eventId' in d) && !('eventSummary' in d) ||
        sparkId(d.eventId) && eventData(d.eventId).get('autoNews',false) &&
        (eventData(d.eventId).type == 'random' || request.time >= eventData(d.eventId).endsAt) &&
        d.eventSummary.keys().hasOnly(['type','groups','unselected']) && d.eventSummary.type == eventData(d.eventId).type &&
        d.eventSummary.groups is list && d.eventSummary.groups.size() == (d.eventSummary.type == 'choice' ? 3 : eventData(d.eventId).get('randomEffectCount',1)) &&
        d.eventSummary.unselected is list && d.eventSummary.unselected.size() <= 100;
    }
    function newsData(d) {
      return d.keys().hasOnly(['title','content','category','companyId','companyName','publishedAt','eventId','eventSummary','dividendChange']) &&
        d.get('category','공지') in ['공지','기업 뉴스','시장 동향','이벤트'] && str(d.title,120) && str(d.content,5000) &&
        d.companyId is string && d.companyId.size() <= 128 && d.companyName is string &&
        (d.companyId == '' ? d.companyName == '' : d.companyName == get(/databases/$(database)/documents/companies/$(d.companyId)).data.name) && eventNewsData(d);
    }
    match /news/{id} {
      allow get: if participant();
      allow list: if participant() && request.query.limit != null && request.query.limit <= 30;
      allow create: if newsData(request.resource.data) && request.resource.data.publishedAt == request.time && ('dividendChange' in request.resource.data ? dividendRateNews(id,request.resource.data) : admin());
      allow update: if admin() && newsData(request.resource.data) &&
        (request.resource.data.publishedAt == request.time ||
          request.resource.data.publishedAt == resource.data.publishedAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventSummary']));
      allow delete: if false;
    }
    match /eventReservations/{id} {
      allow get: if admin();
      allow list: if admin() && request.query.limit != null && request.query.limit <= 100;
      allow create: if competitionRunning() && admin() && !exists(/databases/$(database)/documents/events/$(id)) && reservationData(id,request.resource.data);
      allow delete: if admin() && (resource.data.status == 'pending' || resource.data.status == 'processing' && exists(/databases/$(database)/documents/events/$(id)) && !existsAfter(/databases/$(database)/documents/eventQueue/$(id)));
      allow update: if competitionRunning() && admin() && reservationClaimData(request.resource.data,resource.data);
    }
    function reservationClaimData(d,o) {
      return d.keys().hasAll(['scheduledAt','payload','status','createdAt']) && d.keys().hasOnly(['scheduledAt','payload','status','createdAt']) &&
        d.diff(o).affectedKeys().hasOnly(['status']) && d.status == 'processing' && o.status in ['pending','processing'] &&
        d.scheduledAt is timestamp && d.scheduledAt <= request.time && d.createdAt is timestamp && d.payload is map;
    }
    function reservationReady(id) {
      let p=/databases/$(database)/documents/eventReservations/$(id);
      return !exists(p) || get(p).data.status == 'processing' && get(p).data.scheduledAt <= request.time;
    }
    function reservationData(id,d) {
      return sparkId(id) && d.keys().hasAll(['scheduledAt','payload','status','createdAt']) && d.keys().hasOnly(['scheduledAt','payload','status','createdAt']) &&
        d.status == 'pending' && d.createdAt == request.time && d.scheduledAt is timestamp && d.scheduledAt > request.time && d.scheduledAt <= request.time+duration.value(365,'d') &&
        d.payload is map && d.payload.keys().hasAll(['id','type','title','content','news','deadline']) && d.payload.keys().hasOnly(['id','type','title','content','news','deadline','effects','companyIds','effect']) &&
        d.payload.id == id && d.payload.type == 'random' && str(d.payload.title,120) && d.payload.title.size() > 0 && str(d.payload.content,5000) && d.payload.content.size() > 0 && d.payload.deadline is string &&
        (d.payload.news == null || eventNewsDraftData(d.payload.news)) &&
        ('effects' in d.payload ? d.payload.effects is list && d.payload.effects.size() >= 1 && d.payload.effects.size() <= 20 : d.payload.companyIds is list && d.payload.companyIds.size() > 0 && d.payload.companyIds.size() <= 100 && effectData(d.payload.effect));
    }
    match /events/{id} {
      allow get: if participant();
      allow list: if participant() && request.query.limit != null && request.query.limit <= 100;
      allow create: if competitionRunning() && admin() && reservationReady(id) && request.resource.data.keys().hasOnly(['type','title','content','companyId','targets','options','startsAt','endsAt','autoNews','newsDraftRequired','defaultOption','randomEffectCount']) && request.resource.data.get('autoNews',false) is bool && (!('randomEffectCount' in request.resource.data) || request.resource.data.type == 'random' && id.size() <= 110 && request.resource.data.randomEffectCount is int && request.resource.data.randomEffectCount >= 1 && request.resource.data.randomEffectCount <= 20) && (!('defaultOption' in request.resource.data) || request.resource.data.type == 'choice' && request.resource.data.defaultOption is int && request.resource.data.defaultOption in [0,1,2]) && (!('newsDraftRequired' in request.resource.data) || request.resource.data.newsDraftRequired == true && request.resource.data.autoNews == true && eventNewsDraftData(getAfter(/databases/$(database)/documents/eventNewsDrafts/$(id)).data)) &&
        request.resource.data.type in ['random','choice'] && str(request.resource.data.title,120) && str(request.resource.data.content,5000) &&
        request.resource.data.companyId is string && request.resource.data.targets is list && request.resource.data.targets.size() > 0 && request.resource.data.targets.size() <= 100 &&
        request.resource.data.options is list && (request.resource.data.type == 'choice' ? request.resource.data.options.size() == 3 : request.resource.data.options.size() == 0) &&
        request.resource.data.startsAt == request.time && request.resource.data.endsAt > request.time &&
        (request.resource.data.type == 'random' || getAfter(/databases/$(database)/documents/eventQueue/$(id)).data.endsAt == request.resource.data.endsAt);
      allow update,delete: if false;
    }
    function eventNewsDraftData(d) { return d.keys().hasOnly(['title','content']) && str(d.title,120) && d.title.size() > 0 && str(d.content,5000) && d.content.size() > 0; }
    match /eventNewsDrafts/{eid} {
      allow get: if admin();
      allow create: if admin() && !exists(/databases/$(database)/documents/events/$(eid)) &&
        getAfter(/databases/$(database)/documents/events/$(eid)).data.get('newsDraftRequired',false) == true && eventNewsDraftData(request.resource.data);
      allow list,update,delete: if false;
    }
    // Queue contains only a public activation/deadline; the trusted job retries news too.
    match /eventQueue/{eid} {
      allow create: if admin() && request.resource.data.keys().hasOnly(['endsAt']) &&
        (getAfter(/databases/$(database)/documents/events/$(eid)).data.type == 'choice' ?
          request.resource.data.endsAt == getAfter(/databases/$(database)/documents/events/$(eid)).data.endsAt :
          request.resource.data.endsAt == request.time);
      allow delete: if admin() && eventData(eid).type == 'random';
      allow read, update: if false;
    }
    function eventData(eid) { return get(/databases/$(database)/documents/events/$(eid)).data; }
    function outcome(eid,option) { return get(/databases/$(database)/documents/eventOutcomes/$(eid)/options/$(string(option))).data.effect; }
    function choice(cid,eid) { return get(/databases/$(database)/documents/companyChoices/$(cid)/items/$(eid)).data; }
    function effectData(e) {
      return e.keys().hasAll(['kind','asset','percent','count']) && e.keys().hasOnly(['kind','asset','percent','count','hours','settlements','amount']) &&
        e.kind in ['revenue','efficiency','destroy','none','cash','cost','workforce','grant','dividendCap','salePrice','productionCost','productionPower','salePriceFlat','productionCostFlat','productionPowerFlat'] &&
        (e.kind == 'cost' ? e.asset in ['factory','equipment','research','employee','all'] : e.asset in ['factory','equipment','research']) &&
        e.percent is int && (e.kind == 'cost' ? e.percent >= -90 && e.percent <= 300 : e.kind == 'dividendCap' ? e.percent >= 0 && e.percent <= 100 : e.kind in ['revenue','efficiency','salePrice','productionCost','productionPower'] ? e.percent >= -100 && e.percent <= 500 : e.percent == 0) &&
        ('settlements' in e ? !('hours' in e) && number(e.settlements,365) && (e.kind in ['revenue','efficiency','cost','dividendCap','salePrice','productionCost','productionPower','salePriceFlat','productionCostFlat','productionPowerFlat'] ? e.settlements > 0 : e.settlements == 0) : number(e.hours,2160) && (e.kind in ['revenue','efficiency','cost','dividendCap','salePrice','productionCost','productionPower','salePriceFlat','productionCostFlat','productionPowerFlat'] ? e.hours > 0 : e.hours == 0)) &&
        e.count is int && (e.kind == 'workforce' ? e.count >= -1000 && e.count <= 1000 && e.count != 0 : e.kind in ['destroy','grant'] ? e.count > 0 && e.count <= 1000 : e.count == 0) &&
        (e.kind == 'cash' ? e.amount is int && e.amount >= -100000000 && e.amount <= 100000000 && e.amount != 0 : e.kind in ['salePriceFlat','productionCostFlat','productionPowerFlat'] ? e.amount is int && e.amount >= -1000000 && e.amount <= 1000000 && e.amount != 0 : !('amount' in e));
    }
    match /eventOutcomes/{eid}/options/{option} {
      allow get: if admin() || (participant() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'president' && eventData(eid).type == 'choice' && request.time >= eventData(eid).endsAt &&
        selectedOption(eid,option));
      allow create: if admin() && !exists(/databases/$(database)/documents/events/$(eid)) &&
        getAfter(/databases/$(database)/documents/events/$(eid)).data.type in ['random','choice'] && (getAfter(/databases/$(database)/documents/events/$(eid)).data.get('randomEffectCount',0) > 0 ? option.matches('^(0|[1-9]|1[0-9])$') && int(option) < getAfter(/databases/$(database)/documents/events/$(eid)).data.randomEffectCount && request.resource.data.keys().hasOnly(['effect','targets']) && request.resource.data.targets is list && request.resource.data.targets.size() > 0 && request.resource.data.targets.toSet().difference(getAfter(/databases/$(database)/documents/events/$(eid)).data.targets.toSet()).size() == 0 : option in ['0','1','2'] && request.resource.data.keys().hasOnly(['effect'])) && effectData(request.resource.data.effect);
      allow list,update,delete: if false;
    }
    function selectedOption(eid,option) {
      let assigned=get(/databases/$(database)/documents/assignments/$(request.auth.uid)).data.companyIds;
      return (assigned.size() > 0 && selectedFor(assigned[0],eid,option)) ||
        (assigned.size() > 1 && selectedFor(assigned[1],eid,option)) ||
        (assigned.size() > 2 && selectedFor(assigned[2],eid,option)) ||
        (assigned.size() > 3 && selectedFor(assigned[3],eid,option)) ||
        (assigned.size() > 4 && selectedFor(assigned[4],eid,option));
    }
    function selectedFor(cid,eid,option) {
      return exists(/databases/$(database)/documents/companyChoices/$(cid)/items/$(eid)) && string(choice(cid,eid).option) == option;
    }
    match /companyChoices/{cid}/items/{eid} {
      allow get: if manager(cid);
      allow create: if eventData(eid).type == 'choice' && cid in eventData(eid).targets && request.resource.data.option is int && request.resource.data.option in [0,1,2] && request.resource.data.chosenAt == request.time &&
        ((manager(cid) && request.time < eventData(eid).endsAt && !operations(cid).locked && request.resource.data.keys().hasOnly(['option','chosenAt'])) ||
         (admin() && request.time >= eventData(eid).endsAt && request.resource.data.keys().hasOnly(['option','chosenAt','automatic']) && request.resource.data.automatic == true && request.resource.data.option == eventData(eid).defaultOption));
      allow list,update,delete: if false;
    }
    function eventReceipt(cid,receiptId,d) {
      let eid=d.get('eventId',receiptId);
      let e=eventData(eid);
      return (!('eventId' in d) || e.type == 'random' && e.get('randomEffectCount',0) > 0) && manager(cid) && (!(d.effect.kind in ['cash','cost','workforce','grant','dividendCap','salePrice','productionCost','productionPower','salePriceFlat','productionCostFlat','productionPowerFlat']) || (admin() && exists(/databases/$(database)/documents/companyOperations/$(cid)))) && cid in e.targets && (e.type == 'random' ? admin() && (e.get('randomEffectCount',0) > 0 ? d.option is int && d.option >= 0 && d.option < e.randomEffectCount && receiptId == eid+'_e'+string(d.option) && cid in get(/databases/$(database)/documents/eventOutcomes/$(eid)/options/$(string(d.option))).data.targets : d.option == 0 && !('eventId' in d)) : request.time >= e.endsAt && d.option == choice(cid,eid).option) &&
        d.keys().hasOnly(['option','effect','appliedAt','effectiveAt','result','startsAfterSettlement','eventId']) &&
        (d.effect.get('settlements',0) > 0 ? d.startsAfterSettlement == (exists(/databases/$(database)/documents/companyOperations/$(cid)) ? operations(cid).get('settlementCount',0) : 0) : !('startsAfterSettlement' in d)) &&
        (!('result' in d) || (d.effect.kind == 'destroy' ? d.result.keys().hasOnly(['count']) && d.result.count == operations(cid)[d.effect.asset]-getAfter(/databases/$(database)/documents/companyOperations/$(cid)).data[d.effect.asset] : admin() && d.effect.kind in ['cash','workforce','grant'] && d.result is map && d.result.keys().hasOnly(['amount','count']))) && d.effect == outcome(eid,d.option) && d.appliedAt == request.time && d.effectiveAt == (e.type == 'choice' ? e.endsAt : e.startsAt) &&
        (!exists(/databases/$(database)/documents/companyOperations/$(cid)) ||
          (!operations(cid).locked && (!(d.effect.kind in ['destroy','efficiency','grant']) || (operations(cid).get('productionModel','legacy') == 'units-v2' || operations(cid).revenue == 0 && operations(cid).pendingRevenue == 0 || operations(cid).keys().hasAll(['production','pendingProduction']))) && getAfter(/databases/$(database)/documents/companyOperations/$(cid)).data.lastEvent == receiptId));
    }
    match /companyEffects/{cid}/items/{eid} {
      // Applied outcomes are investor information; unrevealed outcomes stay private.
      allow get: if participant();
      allow list: if participant() && request.query.limit != null && request.query.limit <= 100;
      allow create: if eventReceipt(cid,eid,request.resource.data);
      allow update,delete: if false;
    }
    // Isolated test accounts; original portfolios remain immutable.
    // tradeTests/{uid}: cash int, positions {test-a?:int,test-b?:int}, version int, lastOrderId string.
    function testAccount(d) {
      return d.keys().hasOnly(['cash','positions','version','lastOrderId']) &&
        d.cash is int && d.cash >= 0 && d.cash <= 1000000000000 &&
        d.positions is map && d.positions.keys().hasOnly(['test-a','test-b']) &&
        d.positions.get('test-a',0) is int && d.positions.get('test-a',0) >= 0 && d.positions.get('test-a',0) <= 1000000 &&
        d.positions.get('test-b',0) is int && d.positions.get('test-b',0) >= 0 && d.positions.get('test-b',0) <= 1000000 &&
        d.version is int && d.version >= 0 && d.version <= 1000000000 &&
        d.lastOrderId is string && d.lastOrderId.size() <= 80;
    }
    function testChange(uid) {
      let d=request.resource.data;
      let o=getAfter(/databases/$(database)/documents/tradeTests/$(uid)/orders/$(d.lastOrderId)).data;
      let c=get(/databases/$(database)/documents/companies/$(o.companyId)).data;
      let before=resource.data.positions.get(o.companyId,0);
      let after=d.positions.get(o.companyId,0);
      return marketOpen() && testAccount(d) && d.lastOrderId.matches('^[A-Za-z0-9_-]{1,80}$') &&
        !exists(/databases/$(database)/documents/tradeTests/$(uid)/orders/$(d.lastOrderId)) &&
        d.version == resource.data.version+1 && o.version == d.version &&
        o.keys().hasOnly(['companyId','side','quantity','price','total','version','createdAt']) &&
        o.companyId in ['test-a','test-b'] && c.status == 'listed' &&
        o.quantity is int && o.quantity > 0 && o.quantity <= 1000000 &&
        o.price is int && o.price > 0 && o.price <= 100000000 && o.price == c.referencePrice &&
        o.total is int && o.total == o.price*o.quantity && o.total <= 1000000000000 &&
        o.createdAt == request.time &&
        d.positions.diff(resource.data.positions).affectedKeys().hasOnly([o.companyId]) &&
        ((o.side == 'buy' && d.cash == resource.data.cash-o.total && after == before+o.quantity) ||
         (o.side == 'sell' && before >= o.quantity && d.cash == resource.data.cash+o.total && after == before-o.quantity));
    }
    match /tradeTests/{uid} {
      allow get: if owner(uid) && participant();
      allow create: if owner(uid) && participant() && testAccount(request.resource.data) &&
        request.resource.data.cash == 1000000 && request.resource.data.positions == {} &&
        request.resource.data.version == 0 && request.resource.data.lastOrderId == '';
      allow update: if owner(uid) && participant() && testChange(uid);
      allow list,delete: if false;
      match /orders/{orderId} {
        allow get: if owner(uid) && participant();
        allow list: if owner(uid) && participant() && request.query.limit != null && request.query.limit <= 20;
        allow create: if owner(uid) && participant() && orderId.matches('^[A-Za-z0-9_-]{1,80}$') &&
          getAfter(/databases/$(database)/documents/tradeTests/$(uid)).data.lastOrderId == orderId &&
          getAfter(/databases/$(database)/documents/tradeTests/$(uid)).data.version == get(/databases/$(database)/documents/tradeTests/$(uid)).data.version+1 &&
          request.resource.data.version == getAfter(/databases/$(database)/documents/tradeTests/$(uid)).data.version;
        allow update,delete: if false;
      }
    }
    // Spark-only two-symbol limit exchange. Books contain pseudonymous order
    // entries, not names/email/balances. Private accounts/orders/fills stay owner-only.
    // Sorted immutable indexes prove price/time priority without a fixed order-count cap.
    function sparkId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function orderId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{8,80}$'); }
    function number(v,n) { return v is int && v >= 0 && v <= n; }
    function signedCash(v) { return v is int && v >= -1000000000000 && v <= 1000000000000; }
    function sparkAccount(d) {
      return d.keys().hasOnly(['cash','reservedCash','positions','reservedPositions','version','lastMarket','correctionRevision']) &&
        number(d.get('correctionRevision',0),1000000) && signedCash(d.cash) && number(d.reservedCash,d.cash > 0 ? d.cash : 0) && number(d.version,1000000000) &&
        d.positions is map && d.reservedPositions is map &&
        number(d.positions.get(d.lastMarket,0),1000000) &&
        number(d.reservedPositions.get(d.lastMarket,0),d.positions.get(d.lastMarket,0)) &&
        (sparkId(d.lastMarket) || d.lastMarket == '');
    }
    function sparkBefore(cid) { return get(/databases/$(database)/documents/sparkBooks/$(cid)).data; }
    function sparkAfter(cid) { return getAfter(/databases/$(database)/documents/sparkBooks/$(cid)).data; }
    function accountAdvanced(uid,cid) {
      let d=getAfter(/databases/$(database)/documents/sparkAccounts/$(uid)).data;
      return d.version == get(/databases/$(database)/documents/sparkAccounts/$(uid)).data.version+1 && d.lastMarket == cid;
    }
    function orderAdvanced(e,cid,v) {
