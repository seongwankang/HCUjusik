        request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastEvent']) ? eventOperation(cid,request.resource.data,resource.data) :
        resource.data.get('productionModel','legacy') == 'units-v2' ? (request.resource.data.get('lastRefund','') != resource.data.get('lastRefund','') ? unitsRefund(cid,request.resource.data,resource.data,request.resource.data.lastRefund) : unitsInvestment(cid,request.resource.data,resource.data)) :
        investment(cid,request.resource.data,resource.data,request.resource.data.factory != resource.data.factory ? 'factory' : request.resource.data.equipment != resource.data.equipment ? 'equipment' : request.resource.data.research != resource.data.research ? 'research' : 'employee'));
      allow list,delete: if false;
      match /refunds/{id} {
        allow get: if participant();
        allow list: if participant() && request.query.limit != null && request.query.limit <= 30;
        allow create: if unitsRefund(cid,getAfter(/databases/$(database)/documents/companyOperations/$(cid)).data,operations(cid),id);
        allow update,delete: if false;
      }
      match /investments/{id} {
        allow get: if participant();
        allow list: if participant() && request.query.limit != null && request.query.limit <= 30;
        allow create: if sparkId(id) && investmentReceipt(cid,id,request.resource.data);
        allow update,delete: if false;
      }
      match /days/{dayId} {
        allow get: if participant();
        allow list: if participant() && request.query.limit != null && request.query.limit <= 30;
        allow create: if competitionRunning() && admin() && !operations(cid).locked && request.resource.data.day == dayNumber() && request.resource.data.day > operations(cid).lastSettledDay &&
          request.resource.data.createdAt == request.time && getAfter(/databases/$(database)/documents/companyOperations/$(cid)).data.currentDay == dayId &&
          getAfter(/databases/$(database)/documents/companyOperations/$(cid)).data.settlementCount == operations(cid).get('settlementCount',0)+1;
        allow update,delete: if false;
        match /payouts/{uid} {
          allow get: if admin() || (owner(uid) && participant());
          allow create: if admin() && validDividend(cid,dayId,uid,request.resource.data);
          allow list,update,delete: if false;
        }
      }
    }
    function validDividend(cid,dayId,uid,receipt) {
      let o=operations(cid);
      let day=get(/databases/$(database)/documents/companyOperations/$(cid)/days/$(dayId)).data;
      let a=get(/databases/$(database)/documents/sparkAccounts/$(uid)).data;
      let after=getAfter(/databases/$(database)/documents/sparkAccounts/$(uid)).data;
      let opAfter=getAfter(/databases/$(database)/documents/companyOperations/$(cid)).data;
      let history=getAfter(/databases/$(database)/documents/sparkAccounts/$(uid)/dividends/$(cid+'_'+dayId)).data;
      return o.locked && o.currentDay == dayId && history == {'companyId':cid,'dayId':dayId,'day':day.day,'shares':receipt.shares,'amount':receipt.amount,'createdAt':request.time} &&
        receipt == {'shares':a.positions[cid],'amount':day.perShare*a.positions[cid],'createdAt':request.time} && receipt.shares > 0 &&
        after.cash == a.cash+receipt.amount && after.version == a.version+1 && after.lastMarket == cid &&
        after.diff(a).affectedKeys().hasOnly(['cash','version','lastMarket']) && signedCash(after.cash) &&
        opAfter.paidShares == o.paidShares+receipt.shares && opAfter.paidAmount == o.paidAmount+receipt.amount;
    }
    function dividendAccount(uid) {
      let cid=request.resource.data.lastMarket;
      let key=operations(cid).currentDay;
      let receipt=getAfter(/databases/$(database)/documents/companyOperations/$(cid)/days/$(key)/payouts/$(uid)).data;
      return !exists(/databases/$(database)/documents/companyOperations/$(cid)/days/$(key)/payouts/$(uid)) && validDividend(cid,key,uid,receipt);
    }

    function readableNews(nid) { return participant() && exists(/databases/$(database)/documents/news/$(nid)); }
    function voteBefore(nid,cid) {
      return exists(/databases/$(database)/documents/news/$(nid)/comments/$(cid)/votes/$(request.auth.uid)) ? get(/databases/$(database)/documents/news/$(nid)/comments/$(cid)/votes/$(request.auth.uid)).data.value : 0;
    }
    function reactionChange(nid,cid) {
      let d=request.resource.data;
      let o=resource.data;
      let before=voteBefore(nid,cid);
      let after=getAfter(/databases/$(database)/documents/news/$(nid)/comments/$(cid)/votes/$(request.auth.uid)).data;
      return !o.deleted && d.diff(o).affectedKeys().hasOnly(['likes','dislikes']) && after.value in [-1,0,1] && after.updatedAt == request.time &&
        d.likes is int && d.dislikes is int && d.likes >= 0 && d.dislikes >= 0 &&
        d.likes == o.likes+(after.value == 1 ? 1 : 0)-(before == 1 ? 1 : 0) &&
        d.dislikes == o.dislikes+(after.value == -1 ? 1 : 0)-(before == -1 ? 1 : 0);
    }
    match /news/{nid}/comments/{cid} {
      allow get: if readableNews(nid);
      allow list: if readableNews(nid) && request.query.limit != null && request.query.limit <= 30;
      allow create: if readableNews(nid) && orderId(cid) && request.resource.data.keys().hasOnly(['uid','authorName','content','createdAt','likes','dislikes','deleted']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName &&
        str(request.resource.data.content,1000) && request.resource.data.content.matches('(?s).*\\S.*') && request.resource.data.createdAt == request.time && request.resource.data.likes == 0 && request.resource.data.dislikes == 0 && request.resource.data.deleted == false &&
        getAfter(/databases/$(database)/documents/news/$(nid)/commentLimits/$(request.auth.uid)).data == {'lastCommentId':cid,'createdAt':request.time};
      allow update: if readableNews(nid) &&
        ((admin() && !resource.data.deleted && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content','authorName','deleted','deletedAt']) && request.resource.data.content == '' && request.resource.data.authorName == '' && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time) || reactionChange(nid,cid));
      allow delete: if false;
      match /votes/{uid} {
        allow get: if readableNews(nid) && owner(uid);
        allow create,update: if readableNews(nid) && owner(uid) && request.resource.data.keys().hasOnly(['value','updatedAt']) && request.resource.data.value in [-1,0,1] && request.resource.data.updatedAt == request.time &&
          !get(/databases/$(database)/documents/news/$(nid)/comments/$(cid)).data.deleted &&
          getAfter(/databases/$(database)/documents/news/$(nid)/comments/$(cid)).data.likes == get(/databases/$(database)/documents/news/$(nid)/comments/$(cid)).data.likes+(request.resource.data.value == 1 ? 1 : 0)-(voteBefore(nid,cid) == 1 ? 1 : 0) &&
          getAfter(/databases/$(database)/documents/news/$(nid)/comments/$(cid)).data.dislikes == get(/databases/$(database)/documents/news/$(nid)/comments/$(cid)).data.dislikes+(request.resource.data.value == -1 ? 1 : 0)-(voteBefore(nid,cid) == -1 ? 1 : 0);
        allow list,delete: if false;
      }
    }
    match /news/{nid}/commentLimits/{uid} {
      allow get: if readableNews(nid) && owner(uid);
      allow create,update: if readableNews(nid) && owner(uid) && request.resource.data.keys().hasOnly(['lastCommentId','createdAt']) && orderId(request.resource.data.lastCommentId) && request.resource.data.createdAt == request.time &&
        (!exists(/databases/$(database)/documents/news/$(nid)/commentLimits/$(uid)) || request.time-resource.data.createdAt >= duration.value(3,'s')) &&
        getAfter(/databases/$(database)/documents/news/$(nid)/comments/$(request.resource.data.lastCommentId)).data.uid == uid &&
        getAfter(/databases/$(database)/documents/news/$(nid)/comments/$(request.resource.data.lastCommentId)).data.createdAt == request.time;
      allow list,delete: if false;
    }

    // Official orders and remaining collections default deny.
    match /{document=**} { allow read, write: if false; }
  }
}






